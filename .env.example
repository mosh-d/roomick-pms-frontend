# Copy to .env.local (gitignored) and adjust if the backend runs elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Marketing site (roomick-landing) — a separate app/port, not an internal route.
NEXT_PUBLIC_LANDING_URL=http://localhost:3002

# --- Error tracking (optional — leave unset to disable entirely) ---
# A frontend-specific Sentry project DSN. NEXT_PUBLIC_ because
# instrumentation-client.ts runs in the browser; SENTRY_DSN (no prefix)
# covers the server/edge runtimes — see instrumentation.ts.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to enable source-map upload in CI — never required to build or boot.
SENTRY_ORG=
SENTRY_PROJECT=
